# Test environment. Never point these at anything real.
KERNEL_CLASS='App\Kernel'
APP_SECRET='TestOnlySecretNotUsedAnywhereElse'

# Mails are built and dispatched, but discarded: the suite asserts on the message
# object, and a real transport would only slow the tests down and pollute Mailpit.
MAILER_DSN=null://null
NOTIFICATION_RECIPIENT=ops@example.test

# Requests come straight from the test client, not through nginx.
TRUSTED_PROXIES=

# Separate, ephemeral key pair: Symfony does not load .env.local when APP_ENV=test,
# so the development passphrase is unavailable here by design. Generated by
# `make jwt`; both the keys and this passphrase are throwaway.
JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/test/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/test/public.pem
JWT_PASSPHRASE=test-only-passphrase

# Separate Redis database, so a test run never sees — or clobbers — the
# rate-limiter counters and revocation marks of the development environment.
REDIS_URL=redis://redis:6379/1
