# Default, non-secret values shared by Docker Compose and Symfony.
# Real secrets belong in .env.local (git-ignored) — never here.
# NOTE: keep values free of "$", Compose interpolates this file.

###> docker ###
HTTP_PORT=8080
MYSQL_PORT=3306
MYSQL_DATABASE=app
MYSQL_USER=app
MYSQL_PASSWORD=app
MYSQL_ROOT_PASSWORD=root
###< docker ###

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=change_me_in_env_local
###< symfony/framework-bundle ###

###> doctrine/doctrine-bundle ###
DATABASE_URL="mysql://app:app@mysql:3306/app?serverVersion=8.4&charset=utf8mb4"
###< doctrine/doctrine-bundle ###

###> symfony/mailer ###
# Local SMTP sink (Mailpit). Mails are really delivered, but only to http://localhost:8025
MAILER_DSN=smtp://mailer:1025
MAILER_FROM=no-reply@example.test
###< symfony/mailer ###

###> app/notification ###
# Recipient of product-saved notification e-mails.
NOTIFICATION_RECIPIENT=ops@example.test
###< app/notification ###

###> lexik/jwt-authentication-bundle ###
JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
# Override in .env.local before generating the key pair.
JWT_PASSPHRASE=change_me_in_env_local
###< lexik/jwt-authentication-bundle ###

###> nelmio/cors-bundle ###
CORS_ALLOW_ORIGIN=http://localhost:8080
###< nelmio/cors-bundle ###

###> symfony/routing ###
# Configure how to generate URLs in non-HTTP contexts, such as CLI commands.
# See https://symfony.com/doc/current/routing.html#generating-urls-in-commands
DEFAULT_URI=http://localhost
###< symfony/routing ###

###> docker ###
MAILPIT_PORT=8025
###< docker ###

###> redis ###
# Shared store for rate-limiter counters and token-revocation state.
REDIS_URL=redis://redis:6379
###< redis ###

###> app ###
# Comma-separated proxy IPs, or the keyword private_ranges for a Docker network.
TRUSTED_PROXIES=private_ranges
###< app ###

###> symfony/lock ###
# Choose one of the stores below
# postgresql+advisory://db_user:db_password@localhost/db_name
LOCK_DSN=flock
###< symfony/lock ###
